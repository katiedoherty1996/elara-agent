# systemd unit for the unattended build loop. Replace YOUR_USER with your Linux user.
# Install:  sed "s/YOUR_USER/$USER/g" scripts/elara-agent.service | sudo tee /etc/systemd/system/elara-agent.service
#           sudo systemctl daemon-reload
# Start:    sudo systemctl enable --now elara-agent
# Watch:    tail -f ~/agent.log      (or: journalctl -fu elara-agent)
# Pause:    sudo systemctl stop elara-agent
[Unit]
Description=Elara autonomous build agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/elara
Environment=HOME=/home/YOUR_USER
Environment=ELARA_REPO=/home/YOUR_USER/elara
ExecStart=/home/YOUR_USER/elara-agent/scripts/run-agent.sh
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
